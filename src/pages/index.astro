---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HomePage } from '../components/pages/HomePage';
import { driveIndex } from '../lib/content';
import { getStartImage } from '../lib/images';
import { buildSeo } from '../lib/seo';

const startsida = await getEntry('startsida', 'startsida');
const seo = buildSeo({
  path: '/',
  title: 'BF Rörsjöhus – bostadsförening på Föreningsgatan 43, Malmö',
  description: driveIndex.startsida?.summary ?? '',
  isHome: true,
});
---

<BaseLayout seo={seo} path="/">
  <HomePage
    welcomeHtml={startsida?.rendered?.html ?? ''}
    startImage={await getStartImage()}
    pages={driveIndex.pages}
    documentCount={driveIndex.files.length}
  />
</BaseLayout>
