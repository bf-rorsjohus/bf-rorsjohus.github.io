---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocumentsPage } from '../../components/pages/DocumentsPage';
import { driveIndex } from '../../lib/content';
import { buildSeo } from '../../lib/seo';

const seo = buildSeo({
  path: '/dokument/',
  title: 'Dokument och årsredovisningar',
  description: `Årsredovisningar, stadgar och andra dokument för BF Rörsjöhus i Malmö: ${driveIndex.files
    .slice(0, 4)
    .map((f) => f.title)
    .join(', ')}.`,
});
---

<BaseLayout seo={seo} path="/dokument/">
  <DocumentsPage files={driveIndex.files} />
</BaseLayout>
