---
// /dokument/ (by name, A–Ö) plus one pre-rendered page per other sort order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocumentsPage } from '../../components/pages/DocumentsPage';
import { driveIndex } from '../../lib/content';
import { FILE_SORTS, fileSortHref, sortFiles, type FileSort } from '../../lib/file-sort';
import { buildSeo } from '../../lib/seo';

export function getStaticPaths() {
  return FILE_SORTS.map((sort) => ({ params: { sort: sort.key || undefined }, props: { sort } }));
}

const { sort } = Astro.props as { sort: FileSort };
const seo = buildSeo({
  path: fileSortHref(sort),
  canonicalPath: '/dokument/', // the sorted variants are the same content
  title: 'Dokument och årsredovisningar',
  description: `Årsredovisningar, stadgar och andra dokument för BF Rörsjöhus i Malmö: ${driveIndex.files
    .slice(0, 4)
    .map((f) => f.title)
    .join(', ')}.`,
});
---

<BaseLayout seo={seo} path="/dokument/">
  <DocumentsPage files={sortFiles(driveIndex.files, sort)} sort={sort} />
</BaseLayout>

<script>
  import '../../scripts/viewer/index.ts';
</script>
