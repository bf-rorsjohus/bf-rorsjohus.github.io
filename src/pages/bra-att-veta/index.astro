---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GuideIndexPage } from '../../components/pages/GuideIndexPage';
import { driveIndex } from '../../lib/content';
import { buildSeo } from '../../lib/seo';

const seo = buildSeo({
  path: '/bra-att-veta/',
  title: 'Bra att veta',
  description:
    'Praktisk information för dig som bor i BF Rörsjöhus på Föreningsgatan 43 i Malmö: regler, rutiner och vanliga frågor.',
  breadcrumbs: [
    { name: 'Hem', path: '/' },
    { name: 'Bra att veta', path: '/bra-att-veta/' },
  ],
});
---

<BaseLayout seo={seo} path="/bra-att-veta/">
  <GuideIndexPage pages={driveIndex.pages} />
</BaseLayout>
