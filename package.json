{
  "name": "bf-rorsjohus-webbplats",
  "version": "1.0.0",
  "private": true,
  "description": "Webbplats för BF Rörsjöhus u p a. Statisk Astro-sajt; innehållet hämtas från Google Drive-mappen Hemsida.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "sync": "node scripts/sync-drive.ts",
    "drive:login": "node scripts/sync-local.ts login",
    "drive:sync": "node scripts/sync-local.ts sync",
    "sync:fixtures": "node scripts/sync-drive.ts --fixtures",
    "check-changed": "node scripts/check-changed.ts",
    "build": "astro check && astro build && node scripts/check-dist.ts",
    "preview": "astro preview",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.4",
    "glightbox": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
